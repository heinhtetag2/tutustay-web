# Names only. No secrets in this repo.
# Which payment model the UI renders. 'cash' = request -> property confirms, pay at property.
# 'deposit' = KBZPay deposit confirms the booking. See docs/01-product-audit.md (CT-1, Q1).
NEXT_PUBLIC_PAYMENT_MODEL=cash

# Optional, server-only. When set, ROOMS (the one endpoint with an observed contract) come from this
# API instead of mock fixtures: e.g. https://dev.tutustay.com. Leave unset for fully mock data.
# TUTUSTAY_API_BASE_URL=

# Optional map tiles. The default is OpenStreetMap (no key; fine for a prototype, check its usage policy before launch).
# Point at a keyed provider without code changes, e.g. MapTiler:
# NEXT_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
